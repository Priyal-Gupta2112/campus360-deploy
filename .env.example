# Copy this file to .env and fill in your own values.
# Never commit .env or put service-role keys in frontend code.
PORT=3001
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVER_ONLY_SERVICE_ROLE_KEY

# MiniMoth Live Mode API key (server only; never use a VITE_ prefix)
MINIMOTH_API_KEY=YOUR_MINIMOTH_LIVE_API_KEY
